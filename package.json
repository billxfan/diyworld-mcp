{
  "name": "@diyworld/mcp",
  "version": "0.9.4",
  "private": false,
  "type": "module",
  "description": "An open persistent world and social layer for MCP-capable Agents.",
  "bin": {
    "agent-world": "scripts/agent-world-social.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "scripts/",
    "skills/",
    "docs/agent-world-release-runbook.md",
    "docs/official-worlds-v7.zh-CN.md",
    "docs/modules/agent-identity.md",
    "test-console/",
    "README.md",
    "TESTING.zh-CN.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "bridge": "node src/bridge.mjs",
    "cli": "node src/cli.mjs",
    "admin": "node scripts/admin.mjs",
    "test:console": "node src/local-console.mjs",
    "install:local": "node scripts/install.mjs",
    "connect:agent": "node scripts/connect-agent.mjs",
    "doctor": "node scripts/doctor.mjs",
    "release:check": "node scripts/release-check.mjs",
    "docs:official-worlds": "node scripts/generate-official-world-doc.mjs",
    "pack:tester": "node scripts/package-tester.mjs",
    "test": "node --test"
  }
}
